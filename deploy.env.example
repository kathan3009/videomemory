# Railway backend
VIDEOMEMORY_HOSTED=1
VIDEOMEMORY_DATA_ROOT=/data/videomemory
VIDEOMEMORY_WEB_ORIGINS=https://your-site.example
VIDEOMEMORY_ALLOWED_HOSTS=your-api.example
VIDEOMEMORY_JOB_CONCURRENCY=1
VIDEOMEMORY_MCP_CONCURRENCY=2
VIDEOMEMORY_MAX_ACTIVE_JOBS=4
VIDEOMEMORY_MAX_VIDEO_SECONDS=3600
VIDEOMEMORY_MAX_DOWNLOAD_BYTES=104857600
VIDEOMEMORY_MAX_UPLOAD_BYTES=104857600
VIDEOMEMORY_MAX_TENANT_BYTES=367001600
VIDEOMEMORY_MAX_GLOBAL_BYTES=471859200
VIDEOMEMORY_DOWNLOAD_TIMEOUT_SECONDS=300
VIDEOMEMORY_MEDIA_PROCESS_TIMEOUT_SECONDS=300
VIDEOMEMORY_WHISPER_MODEL=tiny

# Account security. Use a verified sending domain for the From address.
VIDEOMEMORY_REQUIRE_EMAIL_VERIFICATION=1
VIDEOMEMORY_WEB_URL=https://your-site.example
VIDEOMEMORY_EMAIL_FROM=Videomemory <accounts@your-domain.example>
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=

# Vercel frontend
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional billing. Checkout remains disabled until all three are present.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional fixed Razorpay plan IDs; otherwise they are created on first checkout.
RAZORPAY_PLAN_CREATOR=
RAZORPAY_PLAN_STUDIO=
