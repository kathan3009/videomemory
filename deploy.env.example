# Railway backend
VIDEOMEMORY_HOSTED=1
VIDEOMEMORY_DATA_ROOT=/data/videomemory
VIDEOMEMORY_WEB_ORIGINS=https://your-site.example
VIDEOMEMORY_ALLOWED_HOSTS=your-api.example
VIDEOMEMORY_JOB_CONCURRENCY=1
VIDEOMEMORY_MAX_VIDEO_SECONDS=3600
VIDEOMEMORY_MAX_DOWNLOAD_BYTES=2147483648
VIDEOMEMORY_DOWNLOAD_TIMEOUT_SECONDS=900
VIDEOMEMORY_WHISPER_MODEL=small

# Optional billing. Checkout remains disabled until all three are present.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional fixed Razorpay plan IDs; otherwise they are created on first checkout.
RAZORPAY_PLAN_CREATOR=
RAZORPAY_PLAN_STUDIO=
